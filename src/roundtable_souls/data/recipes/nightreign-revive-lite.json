{
  "recipe": 1,
  "id": "nightreign-revive-lite",
  "label": "Nightreign Revive",
  "match": {
    "files": ["edition.json", "revive-maintenance.json", "tools/merge/Assets.exe", "payload/RevivePrototype.dll"],
    "json": [{"file": "edition.json", "key": "edition", "equals": "LITE"}],
    "version": {"file": "revive-maintenance.json", "key": "version"},
    "versions": ["0.1.33-rc3"]
  },
  "tool": {"path": "tools/merge/Assets.exe", "env": {"NRR_GAME_DIRECTORY": "{game_dir}"}, "timeout": 900},
  "output": {"mod": "mod", "report": "merge-report.txt", "manifest": "installation.json"},
  "steps": [
    {"do": "copy_tree", "from": "payload/audio", "to": "audio"},
    {"do": "copy_tree", "from": "payload/ui", "to": "ui"},
    {"do": "copy", "from": "payload/RevivePrototype.dll", "to": "RevivePrototype.dll"},
    {"do": "copy", "from": "payload/ReviveHudBootstrap.dll", "to": "ReviveHudBootstrap.dll"},
    {"do": "config", "from": "payload/RevivePrototype.ini", "to": "RevivePrototype.ini"},
    {"do": "tool", "file": "regulation.bin", "missing": "game",
     "args": ["merge-regulation", "{source}", "{setup}/payload/mod/regulation.bin", "{out}", "{setup}/tools/defs"]},
    {"do": "tool", "file": "chr/c0000.anibnd.dcx", "missing": "copy_patch", "patch": "payload/mod/chr/c0000.anibnd.dcx",
     "args": ["merge-archive", "tae", "{source}", "{patch}", "{out}"]},
    {"do": "tool", "file": "chr/c0000.behbnd.dcx", "missing": "copy_patch", "patch": "payload/mod/chr/c0000.behbnd.dcx",
     "args": ["merge-archive", "behavior", "{source}", "{patch}", "{out}"]},
    {"do": "tool", "file": "chr/c0000_a00_hi.anibnd.dcx", "missing": "copy_patch", "patch": "payload/mod/chr/c0000_a00_hi.anibnd.dcx",
     "args": ["merge-archive", "animations", "{source}", "{patch}", "{out}"]},
    {"do": "tool", "file": "chr/c0000_a00_md.anibnd.dcx", "missing": "copy_patch", "patch": "payload/mod/chr/c0000_a00_md.anibnd.dcx",
     "args": ["merge-archive", "animations", "{source}", "{patch}", "{out}"]},
    {"do": "tool", "file": "chr/c0000_a00_lo.anibnd.dcx", "missing": "copy_patch", "patch": "payload/mod/chr/c0000_a00_lo.anibnd.dcx",
     "args": ["merge-archive", "animations", "{source}", "{patch}", "{out}"]},
    {"do": "tool", "file": "sfx/sfxbnd_commoneffects.ffxbnd.dcx", "missing": "copy_patch", "patch": "payload/mod/sfx/sfxbnd_commoneffects.ffxbnd.dcx",
     "args": ["merge-archive", "fx", "{source}", "{patch}", "{out}"]},
    {"do": "tool", "file": "script/talk/m00_00_00_00.talkesdbnd.dcx", "missing": "payload/settings/vanilla/script/talk/m00_00_00_00.talkesdbnd.dcx",
     "args": ["merge-grace", "{source}", "{setup}/payload/settings/m00_00_00_00.talkesdbnd.dcx", "{out}"]},
    {"do": "tool", "each": {"folders_in": "payload/settings/vanilla/msg", "except": ["common"]},
     "file": "msg/{each}/menu_dlc02.msgbnd.dcx", "missing": "payload/settings/vanilla/msg/{each}/menu_dlc02.msgbnd.dcx",
     "text": {"rusru": "payload/settings/rusru.json", "*": "payload/settings/engus.json"},
     "args": ["merge-menu-text", "{source}", "{text}", "{out}"]},
    {"do": "script_append", "folder": "action/script", "entry": "c0000.hks",
     "base": "payload/mod/action/script/c0000.hks", "base_until": "-- Wrap the current mod's Update;",
     "append": "installer/revive.hks",
     "refuse": ["local NrrOriginalUpdate = Update", "-- Nightreign Revive deferred adapter"],
     "refuse_text": "A mod before it already contains Nightreign Revive's script; keep only the original mod in the profile."},
    {"do": "remove", "glob": "**/*.graph-work"}
  ]
}
