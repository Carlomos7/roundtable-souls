# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.spec

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
.pytest_cache/
.ruff_cache/

# Environments
.venv/
.env

# Launcher state (never committed: it is per-machine). Run from source, the launcher keeps its data folder in the
# repository root (settings.data_dir()), so everything it writes there is listed here, anchored with a leading /
# (an unanchored mods/ or saves/ would also hide the source packages of those names).
/launcher_settings.json
/launcher_settings.json.tmp
/logs/
/cache/
/merges.json
/mods/
/profiles/
/backups/
/saves/
/temp/
/updates/
*.log

# Editors
.vscode/
.idea/

# real-data checks: machine-specific paths
scripts/verify/local.toml

# a test build's identity override (scripts/build.py --identity); never committed
src/roundtable_souls/data/build-identity.json
